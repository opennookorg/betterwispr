/* Permission text displayed by macOS. */
"NSAppleEventsUsageDescription" = "BetterWispr met Music et Spotify en pause pendant la dictée et demande à Terminal et iTerm2 quel onglet est au premier plan, afin qu’Envoyer à Claude n’appuie sur Retour que là où Claude Code s’exécute. Chaque fonction est utilisée uniquement si vous l’activez dans les Réglages.";
"NSAudioCaptureUsageDescription" = "BetterWispr enregistre les autres participants lorsque vous commencez les notes de réunion et coupe le son des autres apps pendant la dictée si vous activez Couper le son des autres apps pendant la dictée. L’audio est traité sur ce Mac, envoyé à la connexion API sélectionnée ou envoyé à ChatGPT si vous choisissez la transcription avec l’abonnement Codex. Les enregistrements temporaires sont ensuite supprimés.";
"NSCalendarsFullAccessUsageDescription" = "Lorsque vous activez Utiliser Calendrier, BetterWispr lit l’événement en cours au démarrage des notes de réunion afin de nommer la note et de lister les invités. Il lit les calendriers déjà présents sur ce Mac sans jamais les modifier.";
"NSMicrophoneUsageDescription" = "BetterWispr enregistre votre microphone lorsque vous commencez une dictée. L’audio est traité sur ce Mac, envoyé à la connexion API sélectionnée ou envoyé à ChatGPT si vous choisissez la transcription avec l’abonnement Codex. Les enregistrements temporaires sont ensuite supprimés.";
"NSSpeechRecognitionUsageDescription" = "BetterWispr utilise la reconnaissance vocale d’Apple sur l’appareil uniquement lorsque vous choisissez le modèle Apple. La reconnaissance dans le cloud n’est jamais activée.";
