/* Permission text displayed by macOS. */
"NSAppleEventsUsageDescription" = "BetterWispr pauses Music and Spotify while you dictate, and asks Terminal and iTerm2 which tab is in front so Send to Claude presses Return only where Claude Code runs. Each is used only when you turn it on in Settings.";
"NSAudioCaptureUsageDescription" = "BetterWispr records the other side of a meeting when you start meeting notes, and mutes other apps while you dictate when you turn on Mute other apps while dictating. Audio is processed on this Mac, sent to the API connection you select, or sent to ChatGPT when you select Codex subscription transcription. Temporary recordings are deleted afterwards.";
"NSCalendarsFullAccessUsageDescription" = "When you turn on Use Calendar, BetterWispr reads the event under way as you start meeting notes, to name the note and list who was invited. It reads the calendars already on this Mac and never changes them.";
"NSMicrophoneUsageDescription" = "BetterWispr records your microphone when you start dictation. Audio is processed on this Mac, sent to the API connection you select, or sent to ChatGPT when you select Codex subscription transcription. Temporary recordings are deleted afterwards.";
"NSSpeechRecognitionUsageDescription" = "BetterWispr uses Apple's on-device speech recognition only when you choose the Apple model. Cloud recognition is never enabled.";
